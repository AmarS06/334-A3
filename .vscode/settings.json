{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": ["src", "tests"],
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.rulers": [110],
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff", "editor.formatOnSave": true },
  "ruff.configuration": "${workspaceFolder}/tools/host/ruff.toml",
  "files.exclude": { "refcorpus": true, "**/__pycache__": true },
  "search.exclude": { "refcorpus/**": true, "audit-out/**": true }
}
